NODE_ENV=development
PORT=3000
WEB_APP_URL=http://localhost:3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database-name>?appName=Cluster0

# JWT secrets - generate strong random values, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Gemini API key for the chatbot and product translation (https://aistudio.google.com/)
GEMINI_API_KEY=replace-with-your-real-key
GEMINI_MODEL=gemini-2.5-flash

# Payment provider — only 'mock' is implemented in Phase 1 (no Konnect/Flouci
# merchant account yet). 'konnect'/'flouci' will fail at startup until implemented.
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_WEBHOOK_SECRET=replace-with-a-random-dev-secret

# Web Push (VAPID) — self-generated, no third-party account needed.
# Generate with: npx web-push generate-vapid-keys
# Optional — push notifications are silently disabled until both are set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@libas.tn

# Upload storage driver — only 'local' is implemented for real use (no cloud
# bucket exists yet). 's3' works against any S3-compatible endpoint (AWS S3,
# Cloudflare R2, DigitalOcean Spaces) but fails at startup unless every
# S3_* var below is set.
STORAGE_DRIVER=local
# Optional — only required if STORAGE_DRIVER=s3
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL_BASE=
