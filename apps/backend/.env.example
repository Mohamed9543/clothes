NODE_ENV=development
PORT=3000
WEB_APP_URL=http://localhost:3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database-name>?appName=Cluster0

# JWT secrets - generate strong random values, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
