{
  "expo": {
    "name": "StyleForm",
    "slug": "libas-mobile",
    "scheme": "libas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.styleform.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#b8622e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.styleform.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StyleForm to access your photos to share looks and reviews."
        }
      ]
    ]
  }
}
